# Public repository: only the requested structure is included.
# Everything else remains local, including the original plan, private evidence,
# development source/tests/runners, caches and intermediate results.
/*
!/.gitignore
!/README.md
!/LICENSE
!/USER_GUIDE.md
!/THEORY.md
!/REFERENCES.md
!/Project.toml
!/Manifest.toml
!/notebook/
!/docs/
!/data/
!/figures/

# Local OneDrive AI-use working folders stay private.
/*_AI_Use/

# docs/ contains only the offline demo and GitHub Pages marker.
/docs/*
!/docs/index.html
!/docs/script.js
!/docs/style.css
!/docs/reference.js
!/docs/.nojekyll

# Generated and machine-specific files inside the allowed folders.
**/.ipynb_checkpoints/
**/__pycache__/
*.py[cod]
*.jl.cov
*.jl.*.cov
*.jl.mem
*.jl.*.mem
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/.env
**/.env.*
**/*.tmp
**/*.log
**/.gitkeep
